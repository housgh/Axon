<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Axon.SQLite</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>GoAxon.Store.SQLite</PackageId>
        <Description>SQLite-backed job storage for Axon.Server. Intended for single-instance deployments and local development - SQLite's single-writer model means it does not support the multi-instance dispatch scenario Axon.Store.SqlServer/Postgres/MySql target (see the README).</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Dapper" Version="2.1.66" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Axon.Server\Axon.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
