        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Axon.Postgres</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>GoAxon.Store.Postgres</PackageId>
