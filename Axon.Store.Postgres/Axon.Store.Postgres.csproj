    <ItemGroup>
      <ProjectReference Include="..\Axon.Server\Axon.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
