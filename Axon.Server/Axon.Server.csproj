<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Axon.Server</PackageId>
        <Description>Job scheduler/dispatcher for Axon: SignalR hub, job store, background processors, and an admin dashboard.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Axon.Core\Axon.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Dashboard\index.html" />
      <EmbeddedResource Include="Dashboard\login.html" />
      <EmbeddedResource Include="Dashboard\job.html" />
      <EmbeddedResource Include="Dashboard\axon.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- Lets tests exercise the in-memory store/registry implementations and internal auth
             helpers (PasswordHasher, LoginAttemptTracker, DashboardUserCredentialStore) directly,
             now that they're internal rather than accidentally-public implementation details. -->
        <InternalsVisibleTo Include="Axon.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
