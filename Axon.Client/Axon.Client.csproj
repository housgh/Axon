<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Axon.Client</PackageId>
        <Description>Client library for Axon: enqueue one-off and recurring jobs, and execute jobs dispatched back to this service.</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.19" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Axon.Core\Axon.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Lets tests exercise AxonClient's internal job-info construction (retry policy,
             concurrency key/attribute precedence) without needing a real or faked HubConnection,
             which the public IAxonClient surface alone can't do cleanly. -->
        <InternalsVisibleTo Include="Axon.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
