<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Data.SqlClient's SQL auth path needs ICU globalization data; invariant mode breaks it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Axon.Server\Axon.Server.csproj" />
    <ProjectReference Include="..\..\Axon.Store.SqlServer\Axon.Store.SqlServer.csproj" />
    <ProjectReference Include="..\..\Axon.Server.Redis\Axon.Server.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Axon.Store.SqlServer\Schema.sql" Link="Schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
