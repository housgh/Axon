<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Axon.Server.Redis</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Axon.Server.Redis</PackageId>
        <Description>Redis SignalR backplane for Axon.Server, so job dispatch and dashboard updates reach clients across multiple Axon.Server instances behind a load balancer.</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Axon.Server\Axon.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
